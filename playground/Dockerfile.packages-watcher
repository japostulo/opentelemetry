FROM node:20-slim

WORKDIR /workspace

# Copy workspace root manifests
COPY package.json package-lock.json* tsconfig.base.json tsconfig.json ./

# Copy package manifests for workspace resolution
COPY packages/node/package.json packages/node/tsconfig.json packages/node/tsconfig.build.json ./packages/node/
COPY packages/web/package.json packages/web/tsconfig.json packages/web/tsconfig.build.json ./packages/web/

# Copy playground app manifests so workspaces are fully resolved
COPY playground/nestjs-app/package.json ./playground/nestjs-app/
COPY playground/express-app/package.json ./playground/express-app/
COPY playground/web-app/package.json ./playground/web-app/

# Install all workspace deps (creates symlinks in node_modules)
RUN npm install

# Sources (packages/*/src) are provided via bind mounts at runtime.
# The CMD below does an initial build before starting --watch so that
# apps that depend on dist/ don't start with a missing dist.
CMD sh -c \
  "node_modules/.bin/tsc -p packages/node/tsconfig.build.json --preserveWatchOutput && \
   node_modules/.bin/tsc -p packages/web/tsconfig.build.json --preserveWatchOutput && \
   node_modules/.bin/tsc -p packages/node/tsconfig.build.json --watch --preserveWatchOutput & \
   node_modules/.bin/tsc -p packages/web/tsconfig.build.json --watch --preserveWatchOutput & \
   wait"
