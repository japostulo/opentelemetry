{
  "name": "@haocruz/opentelemetry",
  "version": "1.4.0",
  "description": "HAOC OpenTelemetry library — standardized tracing, metrics, and structured logging for Node.js backends (NestJS & Express)",
  "author": "Hospital Alemão Oswaldo Cruz",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./instrument": {
      "types": "./dist/instrument.d.ts",
      "require": "./dist/instrument.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "require": "./dist/core/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "require": "./dist/nestjs/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "require": "./dist/express/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "instrument": ["./dist/instrument.d.ts"],
      "core": ["./dist/core/index.d.ts"],
      "nestjs": ["./dist/nestjs/index.d.ts"],
      "express": ["./dist/express/index.d.ts"]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": ">=0.72.0",
    "@opentelemetry/exporter-logs-otlp-http": ">=0.214.0",
    "@opentelemetry/exporter-metrics-otlp-http": ">=0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.214.0",
    "@opentelemetry/resources": ">=2.0.0",
    "@opentelemetry/sdk-logs": ">=0.214.0",
    "@opentelemetry/sdk-metrics": ">=2.0.0",
    "@opentelemetry/sdk-node": ">=0.214.0",
    "@opentelemetry/sdk-trace-base": ">=2.0.0",
    "@opentelemetry/semantic-conventions": ">=1.40.0",
    "nestjs-pino": "^4.0.0",
    "pino": "^8.0.0 || ^9.0.0",
    "pino-http": "^9.0.0 || ^10.0.0",
    "pino-pretty": "^11.0.0 || ^13.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "@nestjs/core": { "optional": true },
    "express": { "optional": true },
    "rxjs": { "optional": true }
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "express": "^4.18.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.0",
    "typescript": "^5.3.0"
  }
}
